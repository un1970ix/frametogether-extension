{
  "name": "frametogether-extension",
  "version": "2.0.3",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun build.ts && bun --watch build.ts",
    "build": "bun build.ts",
    "build:firefox": "TARGET=firefox bun build.ts",
    "clean": "rm -rf dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --project scripts",
    "lint:ext": "web-ext lint --source-dir=dist --warnings-as-errors=false",
    "sign:ext": "web-ext sign --source-dir=dist --channel=listed --no-input"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@types/bun": "1.4.4",
    "@types/webextension-polyfill": "0.12.6",
    "web-ext": "10.8.0"
  },
  "peerDependencies": {
    "typescript": "7.0.2"
  },
  "dependencies": {
    "webextension-polyfill": "0.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/un1970ix/frametogether-extension.git"
  },
  "license": "MPL-2.0",
  "author": "Bedir Ekim <root@un1970ix.com> (https://un1970ix.com)",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=26.13.0 <27"
  },
  "packageManager": "bun@1.4.4"
}
